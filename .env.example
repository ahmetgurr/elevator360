# Supabase panelinde: Settings -> API
# Bu iki deger istemciye (tarayici/uygulama) gomulur; gizli degildir.
# Veriyi koruyan sey RLS politikalaridir.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role anahtarini BU DOSYAYA VE ISTEMCIYE ASLA KOYMAYIN.

# ---------------------------------------------------------------------
# Ortam bazli izolasyon (Dev/Prod)
# ---------------------------------------------------------------------
# Expo, calisma moduna (NODE_ENV) gore asagidaki dosyalari OTOMATIK okur —
# bu dosyalarin hicbiri git'e commit edilmez (bkz. .gitignore):
#   .env.development  -> `npx expo start` (varsayilan gelistirme modu)
#   .env.production    -> `npx expo start --no-dev` / EAS production build
# Ikisi de BU dosyayla (.env.example) AYNI iki degiskeni icerir, sadece
# FARKLI Supabase projelerine (dev icin ayri, izole bir proje; prod icin
# canli proje) isaret etmelidir — gercek izolasyon icin dev projesini
# Supabase Dashboard'dan siz olusturup supabase/migrations/ altindaki tum
# .sql dosyalarini orada da calistirmalisiniz.
